{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "backpack/crud": "^6.1",
        "backpack/permissionmanager": "^7.0",
        "backpack/revise-operation": "^2.0",
        "backpack/theme-tabler": "^1.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "druidfi/mysqldump-php": "^1.0",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.12.1",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.2",
        "jargoud/laravel-backpack-dropzone": "^4.1",
        "jaybizzle/crawler-detect": "^1.3",
        "laravel/framework": "^12.0",
        "laravel/jetstream": "^5.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "*",
        "laravel/tinker": "^2.8",
        "league/html-to-markdown": "^5.1",
        "opgginc/laravel-mcp-server": "^2.0",
        "phpoffice/phpword": "^1.4",
        "ralphjsmit/laravel-seo": "^1.4",
        "redberry/mailbox-for-laravel": "^2.3",
        "sebastian/diff": "^6.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-sitemap": "^7.0",
        "teamtnt/laravel-scout-tntsearch-driver": "^16.1",
        "teamtnt/tntsearch": "^5.0",
        "tightenco/ziggy": "^2.0",
        "webklex/laravel-imap": "^6.2"
    },
    "require-dev": {
        "backpack/generators": "^4.0",
        "barryvdh/laravel-debugbar": "^3.9",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ziggy:patch-cache"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "php artisan storage:link",
            "@php artisan ziggy:patch-cache"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "laravel-backpack-dropzone": {
            "type": "vcs",
            "url": "https://github.com/jargoud/laravel-backpack-dropzone.git"
        }
    }
}
