<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
            <exclude>./tests/Unit/BaseTest.php</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- DB de testing DEDICADA: web_tseyor_org_2024_testing (esquema clonado,
             sin datos). Se recrea con scripts/setup-test-db.sh. NUNCA apuntar a la
             DB real: los tests hacen truncate/delete y eso borraría producción. -->
        <env name="DB_DATABASE" value="web_tseyor_org_2024_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- TNTSearch: índices aislados para testing (se limpian en el setUp de los tests) -->
        <env name="TNTSEARCH_STORAGE" value="storage/indexes_test"/>
    </php>
</phpunit>
